---
// Versión A4 del CV. Solo la usa scripts/pdf.mjs para generar el PDF.
import '../styles/print.css';

const { cv, lang } = Astro.props;
const { basics, ui } = cv;
const host = (url) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const today = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long' }).format(new Date());
// El pie va en el margen inferior de la página: no quita espacio al contenido
const pageFooter = `@page {
  @bottom-left { content: ${JSON.stringify(ui.print.note)}; }
  @bottom-right { content: ${JSON.stringify(`${ui.print.updated}: ${today}`)}; }
}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{basics.name} – CV</title>
    <style is:inline set:html={pageFooter}></style>
  </head>
  <body>
    <header class="head">
      <div>
        <h1>{basics.name}</h1>
        <p class="role">{basics.role}</p>
      </div>
      <ul class="contact">
        <li>{basics.location}</li>
        <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
        {basics.phone && <li>{basics.phone}</li>}
        <li><a href="https://luisse.pro">luisse.pro</a></li>
        {basics.links.map((l) => <li><a href={l.url}>{host(l.url)}</a></li>)}
      </ul>
    </header>

    <section>
      <h2>{ui.about}</h2>
      <p>{basics.summary}</p>
    </section>

    <section>
      <h2>{ui.experience}</h2>
      {cv.experience.map((job) => (
        <article class="item">
          <div class="item-head">
            <h3>{job.company} <span class="muted">{job.role}</span></h3>
            {job.period && <span class="period">{job.period}</span>}
          </div>
          {job.bullets?.length > 0 && <ul class="dots">{job.bullets.map((b) => <li>{b}</li>)}</ul>}
        </article>
      ))}
    </section>

    <section>
      <h2>{ui.education}</h2>
      {cv.education.map((e) => (
        <article class="item tight">
          <div class="item-head">
            <h3>{e.title} {e.detail && <span class="muted">{e.detail}</span>}</h3>
            {e.period && <span class="period">{e.period}</span>}
          </div>
        </article>
      ))}
    </section>

    <section>
      <h2>{ui.projects}</h2>
      {cv.projects.map((p) => (
        <article class="item">
          <div class="item-head">
            <h3>{p.name} <span class="muted">{p.stack.join(', ')}</span></h3>
            {p.url && <a class="period" href={p.url}>{host(p.url)}</a>}
          </div>
          <p>{p.description}</p>
        </article>
      ))}
    </section>

    <section>
      <h2>{ui.skills}</h2>
      <dl class="skills">
        {cv.skills.map((g) => (
          <div>
            <dt>{g.group}</dt>
            <dd>{g.items.map((s) => s.name).join(', ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>{ui.languages}</h2>
      <p class="langs">
        {cv.languages.map((l) => <span><strong>{l.name}</strong> {l.level}</span>)}
      </p>
    </section>

  </body>
</html>
