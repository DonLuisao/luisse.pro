---
// Versión A4 del CV. Solo la usa scripts/pdf.mjs para generar el PDF.
import '../styles/print.css';

const { cv, lang } = Astro.props;
const { basics, ui } = cv;
const host = (url) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const today = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long' }).format(new Date());
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{basics.name} – CV</title>
  </head>
  <body>
    <header class="head">
      <div>
        <h1>{basics.name}</h1>
        <p class="role">{basics.role}</p>
      </div>
      <p class="where">{basics.location}<br />{basics.availability}</p>
    </header>

    <div class="cols">
      <aside class="side">
        <section>
          <h2>{ui.contact}</h2>
          <ul class="contact">
            <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
            {basics.phone && <li>{basics.phone}</li>}
            <li><a href="https://luisse.pro">luisse.pro</a></li>
            {basics.links.map((l) => <li><a href={l.url}>{host(l.url)}</a></li>)}
          </ul>
        </section>

        <section>
          <h2>{ui.languages}</h2>
          <dl class="pairs">
            {cv.languages.map((l) => <div><dt>{l.name}</dt><dd>{l.level}</dd></div>)}
          </dl>
        </section>

        <section>
          <h2>{ui.skills}</h2>
          {cv.skills.map((g) => (
            <div class="group">
              <h3>{g.group}</h3>
              <dl class="pairs">
                {g.items.map((s) => <div><dt>{s.name}</dt><dd>{s.level}</dd></div>)}
              </dl>
            </div>
          ))}
        </section>
      </aside>

      <main class="main">
        <section>
          <h2>{ui.about}</h2>
          <p>{basics.summary}</p>
        </section>

        <section>
          <h2>{ui.experience}</h2>
          {cv.experience.map((job) => (
            <article class="item">
              <div class="item-head">
                <h3>{job.company}</h3>
                {job.period && <span class="period">{job.period}</span>}
              </div>
              <p class="muted">{job.role}</p>
              {job.bullets?.length > 0 && <ul class="dots">{job.bullets.map((b) => <li>{b}</li>)}</ul>}
            </article>
          ))}
        </section>

        <section>
          <h2>{ui.education}</h2>
          {cv.education.map((e) => (
            <article class="item">
              <div class="item-head">
                <h3>{e.title}</h3>
                {e.period && <span class="period">{e.period}</span>}
              </div>
              {e.detail && <p class="muted">{e.detail}</p>}
            </article>
          ))}
        </section>

        <section>
          <h2>{ui.projects}</h2>
          {cv.projects.map((p) => (
            <article class="item">
              <div class="item-head">
                <h3>{p.name}</h3>
                {p.url && <a class="period" href={p.url}>{host(p.url)}</a>}
              </div>
              <p>{p.description}</p>
              <p class="muted">{p.stack.join(', ')}</p>
            </article>
          ))}
        </section>
      </main>
    </div>

    <footer class="foot">
      <span>{ui.print.note}</span>
      <span>{ui.print.updated}: {today}</span>
    </footer>
  </body>
</html>
